# Copy to .env for local runs (chaos scripts, eval harness, MCP server).
# Never commit .env. Deployed Lambdas read secrets from SSM Parameter Store instead.

# AWS: the restricted deployer profile created in Phase 1
AWS_PROFILE=nightwatch
AWS_REGION=us-east-2

# Single-tenant for now; every DynamoDB key is still prefixed with the tenant id
NW_TENANT_ID=default

# LLM provider (Phase 3): groq | gemini | ollama | fake
NW_LLM_PROVIDER=groq
# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# Local, zero data egress: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# Discord (Phase 2 webhook, Phase 4 bot with buttons)
DISCORD_WEBHOOK_URL=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# GitHub, for "what changed?" evidence and fix-as-PR (optional for public repos)
GITHUB_TOKEN=
